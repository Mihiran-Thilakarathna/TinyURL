# TinyLink — Environment Variables

# Copy this file to .env.local and fill in your credentials.

# ─── Supabase (PostgreSQL) ────────────────────────────────────────────────────
# Connection pooler URL (used by Prisma at runtime via pgBouncer)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (used by Prisma for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres"

# ─── Upstash Redis ────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://[YOUR-ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-TOKEN]"

# ─── App ──────────────────────────────────────────────────────────────────────
# Used to construct the full short URL displayed to users
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
